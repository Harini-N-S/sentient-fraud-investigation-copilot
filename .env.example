# ==============================================================================
# Rawbank Sentient Fraud Intelligence Platform - Backend Environment Config
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="Rawbank Sentient Fraud Intelligence Platform"
APP_VERSION=1.0.0
DEBUG=false

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Configuration
# Path relative to repository root or absolute path
DATABASE_PATH=database/synthetic_bank.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Pagination Defaults
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=INFO

# ==============================================================================
# Phase 6: Sentient Fraud Investigation Copilot (Groq / LLM Configuration)
# ==============================================================================
# Groq API Key: Server-side only - Never commit actual keys to source control
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=

# Configurable LLM model (e.g., llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Groq API Base URL (OpenAI-compatible chat completion endpoint)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Request timeout in seconds
GROQ_TIMEOUT_SECONDS=30.0

# Mock LLM Adapter Mode (Set to true for automated tests or offline sandbox)
COPILOT_USE_MOCK=false
